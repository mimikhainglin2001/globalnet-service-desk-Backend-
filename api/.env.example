APP_NAME="GlobalNet Service Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the mysql service in ../docker-compose.yml (exposed on 3316)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3316
DB_DATABASE=globalnet_service_desk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@globalnet.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- React SPA / CORS -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional regex for preview deployments, e.g. #^https://globalnet-.*\.vercel\.app$#
CORS_ALLOWED_ORIGINS_PATTERN=

# Sanctum personal access tokens lifetime in minutes (empty = no expiry)
SANCTUM_EXPIRATION=

# --- Service desk -----------------------------------------------------------
TICKET_REFERENCE_PREFIX=GN-
TICKET_REFERENCE_PADDING=6
TICKET_REOPEN_WINDOW_DAYS=7
SLA_CHECK_BATCH_SIZE=100

ATTACHMENTS_DISK=local
ATTACHMENTS_MAX_FILES=3
ATTACHMENTS_MAX_SIZE_KB=2048

IDEMPOTENCY_TTL_HOURS=24

OUTBOX_QUEUE=default
OUTBOX_TRIES=5
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_GRACE_SECONDS=60

RATE_LIMIT_AUTH=5
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_API=120

DEMO_USER_PASSWORD=Password123!
